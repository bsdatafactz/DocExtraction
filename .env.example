# Azure AI Foundry resource — one key covers every deployment on it.
# Both the first-pass (DeepSeek) and escalation (GPT) models are
# deployments on this same resource, reached through its OpenAI-SDK
# v1 surface (no separate Azure endpoint/api-version needed).
FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=https://ai-training-msftfoundry.services.ai.azure.com/openai/v1/
DEEPSEEK_DEPLOYMENT=deepseek-v3.2

# Escalation model — second deployment on the same Foundry resource.
AZURE_OPENAI_DEPLOYMENT=gpt-5
